{
  "name": "silver-cock-service",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "fetch": "bun run src/scripts/fetchLeagueData.ts",
    "fetch:all": "bun run src/scripts/fetchLeagueData.ts --all",
    "my-leagues": "bun run src/scripts/listMyLeagues.ts",
    "ingest": "bun run src/scripts/ingestLeagueData.ts",
    "analytics": "bun run src/scripts/showAnalytics.ts",
    "db:up": "docker compose --env-file /dev/null up -d",
    "db:down": "docker compose --env-file /dev/null down",
    "db:reset": "docker compose --env-file /dev/null down -v && docker compose --env-file /dev/null up -d && bun run db:migrate",
    "db:diff": "atlas migrate diff --env local",
    "db:apply": "atlas migrate apply --env local",
    "db:status": "atlas migrate status --env local",
    "db:lint": "atlas migrate lint --env local --latest 1",
    "db:migrate": "bun run src/scripts/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "yahoo-fantasy": "^5.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}